<Window x:Class="WhereWindsMeetMidiPlayer.Windows.UpdateOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update"
        Width="520" Height="560"
        MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Border Background="{DynamicResource Brush.KeybindOverlayBackground}"
            BorderBrush="{DynamicResource Brush.KeybindOverlayBorder}"
            BorderThickness="2" CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45"
                              Color="{DynamicResource KeybindOverlayShadowColor}"/>
        </Border.Effect>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.KeybindOverlayHeader}"
                    CornerRadius="16,16,0,0" Padding="20,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding TitleText}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.GoldBright}" FontFamily="Georgia"/>
                        <TextBlock Text="{Binding SubtitleText}" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource KeybindEditor.CloseButton}" Command="{Binding CloseCommand}"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,12">
                <StackPanel>
                    <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"
                               Foreground="{DynamicResource Brush.TourBody}"/>
                    <TextBlock Text="{Binding ExtractHintText}" TextWrapping="Wrap" FontSize="10.5" LineHeight="16"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource Brush.KeybindOverlayFooter}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16" Padding="18,12">
                <StackPanel>
                    <ProgressBar Height="6" Margin="0,0,0,8" Maximum="100"
                                 Value="{Binding DownloadProgress}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding LaterLabel}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,0"
                                Command="{Binding RemindLaterCommand}"/>
                        <Button Content="{Binding OpenFolderLabel}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,0"
                                Command="{Binding OpenFolderCommand}"
                                Visibility="{Binding DownloadComplete, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{Binding DownloadLabel}" Style="{StaticResource Button.Gold}"
                                Command="{Binding DownloadCommand}"
                                IsEnabled="{Binding CanDownload}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
