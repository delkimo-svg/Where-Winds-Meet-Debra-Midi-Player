                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="Theme.BackgroundImage">debra-bg-ffxiv.png</sys:String>
    <sys:String x:Key="Theme.SidebarBannerImage">debra-sidebar-menu-bg-ffxiv.png</sys:String>
    <sys:String x:Key="Theme.NowPlayingHero">debra-ffxiv-hero.png</sys:String>
    <sys:String x:Key="Theme.NowPlayingBranchLeft">debra-ffxiv-branch-left.png</sys:String>
    <sys:String x:Key="Theme.NowPlayingBranchRight">debra-ffxiv-branch-right.png</sys:String>
    <sys:String x:Key="Theme.PlayerCornerBr">debra-player-ffxiv-corner-br.png</sys:String>
    <sys:String x:Key="Theme.PlayerCornerBl">debra-player-ffxiv-corner-bl.png</sys:String>
    <sys:String x:Key="Theme.PlayerThumbImage">debra-thumb-ffxiv.png</sys:String>
    <sys:String x:Key="Theme.HeaderDecorImage">debra-header-ffxiv-mist.png</sys:String>
    <sys:String x:Key="Theme.HeaderLogo">debra-ffxiv-header-logo.png</sys:String>
    <sys:String x:Key="Theme.PracticeRollDecor">debra-ffxiv-hero.png</sys:String>
    <sys:String x:Key="Theme.PanelDecorWash">debra-bg-ffxiv.png</sys:String>

    <Color x:Key="BgDeep">#0A0E1B</Color>
    <Color x:Key="BgPanel">#121A2E</Color>
    <Color x:Key="BgElevated">#1B2540</Color>
    <Color x:Key="BgHover">#283454</Color>
    <Color x:Key="Gold">#D8B978</Color>
    <Color x:Key="GoldDim">#8C7A52</Color>
    <Color x:Key="GoldBright">#F4E4BC</Color>
    <Color x:Key="NewBadge">#3DAA6D</Color>
    <Color x:Key="NewBadgeText">#FFFFFF</Color>
    <Color x:Key="TextPrimary">#E4ECFA</Color>
    <Color x:Key="TextMuted">#94A3C0</Color>
    <Color x:Key="BorderSubtle">#3C4A6C</Color>
    <Color x:Key="AccentRed">#7CD0F2</Color>
    <Color x:Key="AccentPink">#7CD0F2</Color>
    <Color x:Key="AccentGlow">#7CD0F2</Color>
    <Color x:Key="SidebarDeep">#080C18</Color>
    <Color x:Key="BackgroundScrim">#8A020412</Color>
    <Color x:Key="CardBackground">#E61B2540</Color>
    <Color x:Key="SettingsShellBackground">#D8121A2E</Color>
    <Color x:Key="HeaderChipBackground">#E61E2946</Color>
    <Color x:Key="HeaderMetaText">#F4E4BC</Color>
    <Color x:Key="HeaderMetaMuted">#A9BBDC</Color>
    <Color x:Key="ChromeButtonForeground">#F4E4BC</Color>
