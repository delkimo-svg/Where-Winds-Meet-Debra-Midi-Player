                                                          Content="{Binding Ui.PracticeOpenAcademy}"
                                                          IsChecked="{Binding IsPracticeAcademyOverlayOpen, Mode=TwoWay}"
                                                          Padding="8,4" Margin="0,0,6,0"
                                                          ToolTip="{Binding Ui.AcademyPracticeHint}"/>
