<Window x:Class="WhereWindsMeetMidiPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WhereWindsMeetMidiPlayer.Converters"
        xmlns:vm="clr-namespace:WhereWindsMeetMidiPlayer.ViewModels"
        xmlns:models="clr-namespace:WhereWindsMeetMidiPlayer.Models"
        xmlns:controls="clr-namespace:WhereWindsMeetMidiPlayer.Controls"
        xmlns:behaviors="clr-namespace:WhereWindsMeetMidiPlayer.Behaviors"
        xmlns:asset="clr-namespace:WhereWindsMeetMidiPlayer.Helpers"
        Title="Debra MIDI Player — Where Winds Meet"
        Height="682" Width="1024"
        MinHeight="640" MinWidth="940"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{DynamicResource Brush.WindowBackground}"
        AllowDrop="True"
        Closing="Window_OnClosing"
        MouseLeftButtonDown="TitleBar_OnMouseDown"
        PreviewDragOver="Window_PreviewDragOver"
        DragOver="Window_DragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_OnPreviewKeyDown">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <DataTemplate x:Key="LibrarySongTemplate" DataType="{x:Type models:Song}">
            <Grid VerticalAlignment="Stretch" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="♪" Foreground="{DynamicResource Brush.Gold}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Text.SongRowTitle}" Text="{Binding DisplayTitle}"
                           ToolTip="{Binding DisplayTitle}"/>
                <Button Grid.Column="2" Content="▶" Style="{StaticResource Button.Icon.Row}" VerticalAlignment="Center"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding DataContext.Ui.PlayTooltip, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                        Click="SongRowPlay_OnClick"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CatalogueTrackTemplate" DataType="{x:Type models:CatalogueTrack}">
            <Grid VerticalAlignment="Stretch" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource Brush.NewBadge}" CornerRadius="4"
                        Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding DataContext.Ui.CatalogueNewBadge, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                               FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.NewBadgeText}"/>
                </Border>
                <TextBlock Grid.Column="1" Style="{StaticResource Text.SongRowTitle}" Text="{Binding DisplayTitle}"
                           ToolTip="{Binding DisplayTitle}"/>
                <Button Grid.Column="2" Content="▶" Style="{StaticResource Button.Icon.Row}" VerticalAlignment="Center"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding DataContext.Ui.PlayTooltip, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                        Click="SongRowPlay_OnClick"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PlaylistSongTemplate">
            <Grid VerticalAlignment="Stretch" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexPlusOneConverter}}"/>
                <TextBlock Grid.Column="1" Text="⋮⋮" Foreground="{DynamicResource Brush.GoldDim}" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="9"/>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="♥" Foreground="{DynamicResource Brush.Gold}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"
                               Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.SongRowTitle}" Text="{Binding DisplayTitle}"
                               ToolTip="{Binding DisplayTitle}"/>
                </Grid>
                <Button Grid.Column="3" Content="▶" Style="{StaticResource Button.Icon.Row}" VerticalAlignment="Center"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding DataContext.Ui.PlayTooltip, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                        Click="SongRowPlay_OnClick"/>
                <TextBlock Grid.Column="4" Text="♫" Foreground="{DynamicResource Brush.Gold}" VerticalAlignment="Center" FontSize="14" Margin="4,0,0,0"
                           Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.IsPlaying, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid FlowDirection="{Binding UiFlowDirection}" ClipToBounds="True" Background="{DynamicResource Brush.WindowBackground}">
    <!-- 1024×682 design — UniformToFill crops edges instead of letterboxing -->
    <Viewbox Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid Width="1024" Height="682" AllowDrop="True" ClipToBounds="True" FlowDirection="{Binding UiFlowDirection}">
            <Image x:Name="MainBackgroundImage" Stretch="UniformToFill"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Brush.BackgroundScrim}"/>

    <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="192"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Title bar spans full width so body column 0 stays sidebar-narrow only -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ClipToBounds="True"
                      Background="{DynamicResource Brush.BgDeep}">
                    <Border x:Name="TitleBarDecorHost" Panel.ZIndex="0" IsHitTestVisible="False"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                            Background="{DynamicResource Brush.BgDeep}"/>
                    <Border x:Name="TitleBarVignette" Panel.ZIndex="0" IsHitTestVisible="False"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#70141518" Offset="0"/>
                                <GradientStop Color="#30141518" Offset="0.32"/>
                                <GradientStop Color="#00141518" Offset="0.52"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="TitleBarEdgeFadeTop" Panel.ZIndex="1" Height="3" VerticalAlignment="Top"
                            HorizontalAlignment="Stretch" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{DynamicResource BgDeep}" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="TitleBarEdgeFadeBottom" Panel.ZIndex="1" Height="3" VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="{DynamicResource BgDeep}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Panel.ZIndex="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="{asset:LocalAsset debra-wwm-header-logo.png}"
                               Height="32" Stretch="Uniform" VerticalAlignment="Center"
                               Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                        <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource Font.HeaderTitle}"
                                   TextOptions.TextFormattingMode="Display">
                            <Run Text="Debra Midi Player" FontSize="17" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.GoldBright}"/>
                            <Run Text="  ·  v" FontSize="11" Foreground="{DynamicResource Brush.GoldDim}"
                                 BaselineAlignment="Center"/>
                            <Run Text="{Binding AppVersionLabel, Mode=OneWay}" FontSize="11" FontWeight="Normal"
                                 Foreground="{DynamicResource Brush.GoldDim}" BaselineAlignment="Center"/>
                            <Run Text="  ·  " FontSize="11" Foreground="{DynamicResource Brush.GoldDim}"
                                 BaselineAlignment="Center"/>
                            <Run Text="Where Winds Meet" FontSize="11" FontWeight="Normal"
                                 Foreground="{DynamicResource Brush.GoldDim}" BaselineAlignment="Center"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel x:Name="TourTarget_Header" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="8,0,8,0">
                        <Button Content="{Binding Ui.HeaderUpdate}" Style="{StaticResource Button.UpdatePulse}"
                                Command="{Binding ShowUpdateOverlayCommand}"
                                ToolTip="{Binding Ui.HeaderUpdateTooltip}"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                FontSize="11" Margin="0,0,8,0"/>
                        <Button Content="{Binding Ui.HeaderPatreon}" Style="{StaticResource Button.Gold}" Padding="12,5"
                                Command="{Binding ShowPatreonRewardsCommand}" ToolTip="{Binding Ui.HeaderPatreonTooltip}"
                                FontSize="11" Margin="0,0,8,0"/>
                        <Button Content="{Binding Ui.HeaderDiscord}" Style="{StaticResource Button.Gold}" Padding="12,5"
                                Command="{Binding OpenDiscordCommand}" ToolTip="{Binding Ui.HeaderDiscordTooltip}"
                                FontSize="11" Margin="0,0,8,0"/>
                        <Button x:Name="TourTarget_HelpButton" Content="?" Style="{StaticResource Button.WindowChrome}" Padding="10,4"
                                Command="{Binding ShowHelpCommand}" ToolTip="{Binding Ui.HelpTooltip}"
                                FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0"/>
                        <Border Background="{DynamicResource Brush.HeaderChipBackground}" CornerRadius="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="10,5" Margin="0,0,8,0" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True" Margin="0,0,8,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <Image Source="{asset:LocalAsset debra-thumb-art.png}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="Debra ▾" Foreground="{DynamicResource Brush.GoldBright}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Brush.BgElevated}" CornerRadius="10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="2,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="—" Style="{StaticResource Button.WindowChrome}" Click="Minimize_OnClick"/>
                                <Button Content="□" Style="{StaticResource Button.WindowChrome}" Visibility="Collapsed" IsEnabled="False"/>
                                <Button Content="✕" Style="{StaticResource Button.WindowChrome}" Click="Close_OnClick"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid>
                </Grid>

                <controls:DebraSidebar x:Name="TourTarget_Sidebar"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="5,6,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch"
                                       NavItems="{Binding NavItems}"/>

                <Grid x:Name="MainContentStack" Grid.Row="1" Grid.Column="1" Margin="0,6,5,0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border Background="{DynamicResource Brush.SettingsShellBackground}" CornerRadius="16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="10"
                                Visibility="{Binding ShowSettingsPanel, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560" ClipToBounds="True">
                                <StackPanel MaxWidth="480">
                                    <TextBlock Text="{Binding Ui.SectionSettings}" Style="{StaticResource Text.SectionHeader}" Margin="0,0,0,16"/>
                                    <TextBlock Text="{Binding Ui.SettingsTheme}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableThemes}" DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                              Style="{StaticResource ComboBox.Debra}" Margin="0,0,0,16"/>
                                    <TextBlock Text="{Binding Ui.SettingsTargetExecutable}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding TargetProcessName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Search}"/>
                                        <Button Grid.Column="1" Content="{Binding Ui.SettingsReset}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding ResetProcessNameCommand}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Ui.SettingsWindowTitle}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding GameWindowTitleContains, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Search}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{Binding Ui.SettingsTestKey}" Style="{StaticResource Button.Gold}" Command="{Binding TestKeyInGameCommand}" Margin="0,0,6,0"/>
                                        <Button Content="{Binding Ui.SettingsDetect}" Style="{StaticResource Button.Ghost}" Command="{Binding DetectGameWindowsCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Ui.SettingsPlayback}" Style="{StaticResource Text.Title}" Margin="0,20,0,8"/>
                                    <TextBlock Text="{Binding Ui.SettingsPlayerHotkeys}" Style="{StaticResource Text.Title}" Margin="0,16,0,4"/>
                                    <TextBlock Text="{Binding Ui.SettingsPlayerHotkeysHint}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsHotkeyPlayPause}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding PlaybackHotkeyPlayPauseLabel}" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding BeginCapturePlaybackHotkeyCommand}" CommandParameter="{x:Static models:PlaybackHotkeyRole.PlayPause}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsHotkeyStop}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding PlaybackHotkeyStopLabel}" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding BeginCapturePlaybackHotkeyCommand}" CommandParameter="{x:Static models:PlaybackHotkeyRole.Stop}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsHotkeyPrevious}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding PlaybackHotkeyPreviousLabel}" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding BeginCapturePlaybackHotkeyCommand}" CommandParameter="{x:Static models:PlaybackHotkeyRole.Previous}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsHotkeyNext}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding PlaybackHotkeyNextLabel}" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding BeginCapturePlaybackHotkeyCommand}" CommandParameter="{x:Static models:PlaybackHotkeyRole.Next}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding PlaybackHotkeyCaptureStatus}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,0,0,6"/>
                                    <Button Content="{Binding Ui.SettingsHotkeyReset}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                            Command="{Binding ResetPlaybackHotkeysCommand}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsSmartTranspose}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Toggle.Debra}" IsChecked="{Binding SmartTranspose}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Ui.SettingsAutoPlayNext}" Style="{StaticResource Text.Muted}" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding AutoPlayNextDelaySeconds, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Search}"/>
                                    <TextBlock Text="{Binding Ui.SettingsAutoPlayNextHint}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <ComboBox ItemsSource="{Binding KeyLayouts}" DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedLayout}" Style="{StaticResource ComboBox.Debra}" Margin="0,12,0,0"/>
                                    <Button Content="{Binding Ui.SettingsEditKeybinds}" Style="{StaticResource Button.Gold}" Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding OpenKeybindEditorCommand}"/>
                                    <Button Content="{Binding Ui.SettingsOpenKeymaps}" Style="{StaticResource Button.Ghost}" Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding OpenKeymapsFolderCommand}"/>
                                    <TextBlock Text="{Binding Ui.SettingsReleaseManifest}" Style="{StaticResource Text.Muted}" Margin="0,20,0,4"/>
                                    <TextBox Text="{Binding ReleaseManifestUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Search}"/>
                                    <TextBlock Text="{Binding Ui.SettingsReleaseManifestHint}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <Button Content="{Binding Ui.HeaderUpdate}" Style="{StaticResource Button.Ghost}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Command="{Binding CheckForUpdatesCommand}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid x:Name="MainPanelsGrid" Visibility="{Binding ShowMainPanels, Converter={StaticResource BoolToVis}}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MainLeftColumn" Width="*" MinWidth="120"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition x:Name="MainPlaylistColumn" Width="*" MinWidth="160"/>
                                <ColumnDefinition x:Name="MainNowPlayingColumn" Width="*" MinWidth="120"/>
                            </Grid.ColumnDefinitions>

                            <GridSplitter x:Name="MainColumnSplitter"
                                          Grid.Column="1"
                                          Width="10"
                                          Margin="0,8"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext"
                                          ShowsPreview="True"
                                          Background="Transparent"
                                          DragCompleted="MainColumnSplitter_OnDragCompleted">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Border x:Name="GripHost" Background="Transparent" CornerRadius="5" Padding="0"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="SizeWE">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border x:Name="GripBar" Width="4" CornerRadius="2" Opacity="0.45"
                                                        Background="{DynamicResource Brush.Border}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                        Margin="0,12"/>
                                                <TextBlock x:Name="GripArrows" Text="‹›" FontSize="8"
                                                           FontFamily="{StaticResource Font.UI}"
                                                           Foreground="{DynamicResource Brush.GoldDim}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Opacity="0.8" IsHitTestVisible="False"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="GripHost" Property="Background" Value="{DynamicResource Brush.BgHover}"/>
                                                <Setter TargetName="GripArrows" Property="Foreground" Value="{DynamicResource Brush.GoldBright}"/>
                                                <Setter TargetName="GripArrows" Property="Opacity" Value="1"/>
                                                <Setter TargetName="GripBar" Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>

                            <!-- LIBRARY (drag-and-drop .mid / .midi / folders) -->
                            <Border x:Name="LibraryDropTarget" Grid.Column="0" Background="{DynamicResource Brush.CardBackground}" CornerRadius="14"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,6,0" Padding="14,12"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    behaviors:FileDropZoneBehavior.IsEnabled="True"
                                    AllowDrop="True"
                                    PreviewDragOver="ExternalFile_PreviewDragOver"
                                    DragOver="LibraryDropTarget_OnDragOver"
                                    DragLeave="LibraryDropTarget_OnDragLeave"
                                    Drop="LibraryDropTarget_OnDrop"
                                    Visibility="{Binding ShowLibraryPanel, Converter={StaticResource BoolToVis}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource PanelShadow}" BlurRadius="14" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Ui.SectionLibrary}" Style="{StaticResource Text.SectionHeader}" Margin="0,0,0,10"/>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding LibraryStatsText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,8">
                                            <TextBox Style="{StaticResource TextBox.Search}" Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False" Margin="12,8,0,0"
                                                        Visibility="{Binding LibrarySearchText, Converter={StaticResource BoolToVisInvert}}">
                                                <TextBlock Text="🔍" Margin="0,0,6,0" Foreground="{DynamicResource Brush.GoldDim}"/>
                                                <TextBlock Text="{Binding Ui.LibrarySearch}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Ui.SortLabel}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                                            <controls:DebraFastDropdown Grid.Column="1"
                                                                        ItemsSource="{Binding LibrarySortOptions}"
                                                                        SelectedItem="{Binding SelectedLibrarySortOption, Mode=TwoWay}"
                                                                        DisplayMemberPath="Label"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding Ui.LibraryImport}" Style="{StaticResource Button.Gold}"
                                                    Command="{Binding ImportLibraryCommand}"
                                                    ToolTip="{Binding Ui.LibraryImportTooltip}"/>
                                            <Button Content="{Binding Ui.LibraryClear}" Style="{StaticResource Button.Ghost}"
                                                    Command="{Binding ClearLibraryCommand}"
                                                    ToolTip="{Binding Ui.LibraryClearTip}"
                                                    Margin="8,0,0,0"/>
                                            <controls:SongTrashBin Margin="8,0,0,0"
                                                                 Command="{Binding RemoveFromLibraryCommand}"
                                                                 CommandParameter="{Binding SelectedLibrarySong}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding LibraryHeaderText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="LibraryDropHint" DockPanel.Dock="Top" Text="{Binding Ui.LibraryDragHint}"
                                               FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <ListBox x:Name="LibraryList" ItemsSource="{Binding FilteredLibrarySongs}" ItemTemplate="{StaticResource LibrarySongTemplate}"
                                             SelectedItem="{Binding SelectedLibrarySong}" Style="{StaticResource ListBox.Debra}"
                                             ItemContainerStyle="{StaticResource ListBoxItem.Song}" MouseDoubleClick="Library_OnDoubleClick"
                                             AllowDrop="True"
                                             PreviewDragOver="ExternalFile_PreviewDragOver"
                                             DragOver="ExternalFile_DragOver"
                                             Drop="LibraryDropTarget_OnDrop"
                                             PreviewMouseLeftButtonDown="LibraryList_OnPreviewMouseLeftButtonDown"
                                             PreviewMouseLeftButtonUp="SongList_OnPreviewMouseLeftButtonUp"
                                             PreviewMouseMove="LibraryList_OnPreviewMouseMove"/>
                                </DockPanel>
                            </Border>

                            <!-- DISCORD CATALOGUE -->
                            <!-- HISTORY (left nav) -->
                            <Border x:Name="TourTarget_History" Grid.Column="0" Background="{DynamicResource Brush.CardBackground}" CornerRadius="14"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,6,0" Padding="14,12"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Visibility="{Binding ShowHistoryPanel, Converter={StaticResource BoolToVis}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource PanelShadow}" BlurRadius="14" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Ui.SectionHistory}" Style="{StaticResource Text.SectionHeader}" VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right" Content="{Binding Ui.HistoryClear}" Style="{StaticResource Button.Ghost}" Command="{Binding ClearHistoryCommand}"/>
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding HistoryStatsText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <ListBox ItemsSource="{Binding HistoryItems}" Style="{StaticResource ListBox.Debra}" BorderThickness="0" Background="Transparent"
                                             ItemContainerStyle="{StaticResource ListBoxItem.Song}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="38" Height="38" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                        <Image Source="{asset:LocalAsset debra-thumb-art.png}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SongTitle}" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource Brush.TextMuted}">
                                                            <Run Text="{Binding DataContext.Ui.HistoryPlayed, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                                                            <Run Text="{Binding PlayedAt, StringFormat={}{0:HH:mm}}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DurationMs, Converter={StaticResource DurationMsConverter}}"
                                                               Foreground="{DynamicResource Brush.GoldBright}" VerticalAlignment="Center" Margin="6,0"/>
                                                    <Button Grid.Column="3" Content="▶" Style="{StaticResource Button.Icon}"
                                                            Command="{Binding DataContext.PlayHistoryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border x:Name="TourTarget_Catalogue" Grid.Column="0" Background="{DynamicResource Brush.CardBackground}" CornerRadius="14"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,6,0" Padding="14,12"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Visibility="{Binding ShowCataloguePanel, Converter={StaticResource BoolToVis}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource PanelShadow}" BlurRadius="14" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Ui.SectionCatalogue}" Style="{StaticResource Text.SectionHeader}" Margin="0,0,0,6"/>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Ui.CatalogueSubtitle}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,0,0,6"/>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding CatalogueStatsText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding CatalogueStatusText}" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}"
                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="{Binding Ui.CatalogueRefresh}" Style="{StaticResource Button.Gold}" Command="{Binding RefreshDiscordCatalogueCommand}"
                                                IsEnabled="{Binding IsCatalogueLoading, Converter={StaticResource BoolToVisInvert}}"/>
                                        <Button Content="{Binding Ui.CataloguePlay}" Style="{StaticResource Button.Ghost}" Margin="6,0,0,0"
                                                Command="{Binding PlayCatalogueTrackCommand}"/>
                                        <Button Content="{Binding Ui.CatalogueFavorite}" Style="{StaticResource Button.Ghost}" Margin="6,0,0,0"
                                                Command="{Binding AddCatalogueToFavoritesCommand}"/>
                                    </StackPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <TextBox Style="{StaticResource TextBox.Search}" Text="{Binding CatalogueSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False" Margin="12,8,0,0"
                                                    Visibility="{Binding CatalogueSearchText, Converter={StaticResource BoolToVisInvert}}">
                                            <TextBlock Text="🔍" Margin="0,0,6,0" Foreground="{DynamicResource Brush.GoldDim}"/>
                                            <TextBlock Text="{Binding Ui.CatalogueSearch}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SortLabel}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                                        <controls:DebraFastDropdown Grid.Column="1"
                                                                    ItemsSource="{Binding CatalogueSortOptions}"
                                                                    SelectedItem="{Binding SelectedCatalogueSortOption, Mode=TwoWay}"
                                                                    DisplayMemberPath="Label"/>
                                    </Grid>
                                    <controls:DebraFastDropdown DockPanel.Dock="Top" Margin="0,0,0,8"
                                                                ItemsSource="{Binding CatalogueStyles}"
                                                                SelectedItem="{Binding CatalogueStyleFilter, Mode=TwoWay}"/>
                                    <ListBox x:Name="CatalogueList" ItemsSource="{Binding FilteredCatalogueTracks}" ItemTemplate="{StaticResource CatalogueTrackTemplate}"
                                             SelectedItem="{Binding SelectedCatalogueTrack}" Style="{StaticResource ListBox.Debra}"
                                             behaviors:ListBoxScrollWheelBehavior.IsEnabled="False"
                                             VerticalAlignment="Stretch"
                                             ItemContainerStyle="{StaticResource ListBoxItem.Song}" MouseDoubleClick="Catalogue_OnDoubleClick"
                                             PreviewMouseWheel="CatalogueList_OnPreviewMouseWheel"
                                             PreviewMouseLeftButtonDown="CatalogueList_OnPreviewMouseLeftButtonDown"
                                             PreviewMouseLeftButtonUp="SongList_OnPreviewMouseLeftButtonUp"
                                             PreviewMouseMove="CatalogueList_OnPreviewMouseMove"/>
                                </DockPanel>
                            </Border>

                            <!-- PLAYLIST (default middle column) -->
                            <Border x:Name="TourTarget_Playlist" Grid.Column="2" Background="{DynamicResource Brush.CardBackground}" CornerRadius="14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,6,0" Padding="14,12"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    behaviors:FileDropZoneBehavior.IsEnabled="True"
                                    AllowDrop="True"
                                    PreviewDragOver="ExternalFile_PreviewDragOver"
                                    DragOver="PlaylistPanel_OnDragOver"
                                    DragLeave="PlaylistPanel_OnDragLeave"
                                    Drop="PlaylistPanel_OnDrop"
                                    Visibility="{Binding ShowPlaylistPanel, Converter={StaticResource BoolToVis}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource PanelShadow}" BlurRadius="14" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Ui.SectionPlaylist}" Style="{StaticResource Text.SectionHeader}"/>
                                        <TextBlock Text="{Binding PlaylistSectionActiveName}" Style="{StaticResource Text.SectionHeader}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding PlaylistStatsText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="PlaylistNameField" Grid.Column="0"
                                                Background="{DynamicResource Brush.InputBackground}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                ToolTip="{Binding Ui.PlaylistNameTip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="PlaylistNameTextBox"
                                                         Grid.Column="0"
                                                         IsEnabled="{Binding IsPlaylistLoading, Converter={StaticResource BoolToVisInvert}}"
                                                         Text="{Binding PlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource TextBox.ComboBoxInline}"
                                                         Margin="10,4,4,4"
                                                         VerticalContentAlignment="Center"
                                                         KeyDown="PlaylistNameTextBox_OnKeyDown"/>
                                                <ToggleButton x:Name="PlaylistPickerToggle"
                                                              Grid.Column="1"
                                                              Focusable="False"
                                                              ClickMode="Press"
                                                              IsEnabled="{Binding IsPlaylistLoading, Converter={StaticResource BoolToVisInvert}}"
                                                              Checked="PlaylistPickerToggle_OnChecked"
                                                              Unchecked="PlaylistPickerToggle_OnUnchecked">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent">
                                                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                                      Fill="{DynamicResource Brush.ComboBoxForeground}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Width="8" Height="5" Stretch="Fill"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <Popup x:Name="PlaylistPickerPopup"
                                                       Placement="Bottom"
                                                       PlacementTarget="{Binding ElementName=PlaylistNameField}"
                                                       AllowsTransparency="False"
                                                       PopupAnimation="None"
                                                       StaysOpen="False">
                                                    <Border MinWidth="{Binding ActualWidth, ElementName=PlaylistNameField}"
                                                            MaxHeight="280"
                                                            Background="{DynamicResource Brush.ComboBoxPopupBackground}"
                                                            BorderBrush="{DynamicResource Brush.ComboBoxPopupBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Margin="0,2,0,0">
                                                        <ListBox x:Name="SavedPlaylistsList"
                                                                 ItemsSource="{Binding SavedPlaylists}"
                                                                 DisplayMemberPath="Name"
                                                                 SelectedValuePath="FilePath"
                                                                 Foreground="{DynamicResource Brush.ComboBoxPopupForeground}"
                                                                 Focusable="True"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 MaxHeight="280"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                 ScrollViewer.CanContentScroll="False"
                                                                 VirtualizingPanel.IsVirtualizing="False"
                                                                 ItemContainerStyle="{StaticResource ListBoxItem.DropdownPopup}"
                                                                 PreviewMouseWheel="SavedPlaylistsList_OnPreviewMouseWheel"
                                                                 SelectionChanged="SavedPlaylistsList_OnSelectionChanged">
                                                            <ListBox.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <VirtualizingStackPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ListBox.ItemsPanel>
                                                        </ListBox>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </Border>
                                        <Button Grid.Column="1" Content="+" Style="{StaticResource Button.Gold}"
                                                Command="{Binding CreatePlaylistAsNamedCommand}"
                                                MinWidth="36" Padding="10,4" Margin="6,0,0,0"
                                                ToolTip="{Binding Ui.PlaylistCreateTip}" VerticalAlignment="Stretch"/>
                                    </Grid>
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button Content="{Binding Ui.PlaylistNew}" Style="{StaticResource Button.Ghost}" Command="{Binding NewPlaylistCommand}" Margin="0,0,4,4"/>
                                        <Button Content="{Binding Ui.PlaylistSave}" Style="{StaticResource Button.Gold}" Command="{Binding SavePlaylistAsNamedCommand}" Margin="0,0,4,4"/>
                                        <Button Content="{Binding Ui.PlaylistOpen}" Style="{StaticResource Button.Ghost}" Command="{Binding LoadPlaylistCommand}" Margin="0,0,4,4"/>
                                        <Button Content="{Binding Ui.PlaylistRename}" Style="{StaticResource Button.Ghost}" Command="{Binding RenameSavedPlaylistCommand}" Margin="0,0,4,4"
                                                ToolTip="{Binding Ui.PlaylistRenameTip}"/>
                                        <Button Content="{Binding Ui.PlaylistDelete}" Style="{StaticResource Button.Ghost}" Command="{Binding DeleteSavedPlaylistCommand}" Margin="0,0,4,4"/>
                                        <ToggleButton Content="{Binding Ui.PlaylistFavoritesOnly}" Style="{StaticResource Toggle.DebraPill}" IsChecked="{Binding PlaylistFavoritesOnly}" Margin="0,0,4,4"
                                                      ToolTip="{Binding Ui.PlaylistFavoritesOnlyTip}"/>
                                    </WrapPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SortLabel}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                                        <controls:DebraFastDropdown Grid.Column="1"
                                                                    ItemsSource="{Binding PlaylistSortOptions}"
                                                                    SelectedItem="{Binding SelectedPlaylistSortOption, Mode=TwoWay}"
                                                                    DisplayMemberPath="Label"/>
                                    </Grid>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="{Binding Ui.PlaylistAdd}" Style="{StaticResource Button.Ghost}" Command="{Binding AddToPlaylistCommand}" Margin="0,0,4,0"/>
                                        <Button Content="▲" Style="{StaticResource Button.Ghost}" Command="{Binding MovePlaylistSongUpCommand}" Margin="0,0,2,0" ToolTip="{Binding Ui.PlaylistMoveUp}"
                                                IsEnabled="{Binding IsPlaylistManualSort}"/>
                                        <Button Content="▼" Style="{StaticResource Button.Ghost}" Command="{Binding MovePlaylistSongDownCommand}" Margin="0,0,4,0" ToolTip="{Binding Ui.PlaylistMoveDown}"
                                                IsEnabled="{Binding IsPlaylistManualSort}"/>
                                        <controls:SongTrashBin Command="{Binding RemoveFromPlaylistCommand}"
                                                               CommandParameter="{Binding SelectedPlaylistSong}"/>
                                    </StackPanel>
                                    <ListBox x:Name="PlaylistList"
                                             ItemsSource="{Binding FilteredPlaylistSongs}"
                                             ItemTemplate="{StaticResource PlaylistSongTemplate}"
                                             SelectedItem="{Binding SelectedPlaylistSong}"
                                             Style="{StaticResource ListBox.Debra}"
                                             ItemContainerStyle="{StaticResource ListBoxItem.Playlist}"
                                             AlternationCount="10000"
                                             AllowDrop="True"
                                             PreviewDragOver="ExternalFile_PreviewDragOver"
                                             DragOver="PlaylistList_OnDragOver"
                                             Drop="PlaylistList_OnDrop"
                                             PreviewMouseLeftButtonDown="PlaylistList_OnPreviewMouseLeftButtonDown"
                                             PreviewMouseLeftButtonUp="SongList_OnPreviewMouseLeftButtonUp"
                                             PreviewMouseMove="PlaylistList_OnPreviewMouseMove"
                                             MouseDoubleClick="Playlist_OnDoubleClick"/>
                                </DockPanel>
                            </Border>

                            <!-- FAVORITES (left column; playlist stays visible beside it) -->
                            <Border x:Name="FavoritesDropTarget" Grid.Column="0" Background="{DynamicResource Brush.CardBackground}" CornerRadius="14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,6,0" Padding="14,12"
                                    Visibility="{Binding ShowFavoritesPanel, Converter={StaticResource BoolToVis}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource PanelShadow}" BlurRadius="14" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Ui.SectionFavorites}" Style="{StaticResource Text.SectionHeader}" Margin="0,0,0,10"/>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding FavoritesStatsText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,8">
                                            <TextBox Style="{StaticResource TextBox.Search}" Text="{Binding FavoritesSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False" Margin="12,8,0,0"
                                                        Visibility="{Binding FavoritesSearchText, Converter={StaticResource BoolToVisInvert}}">
                                                <TextBlock Text="♥" Margin="0,0,6,0" Foreground="{DynamicResource Brush.GoldDim}"/>
                                                <TextBlock Text="{Binding Ui.FavoritesSearch}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                        <controls:SongTrashBin Margin="0,0,4,4"
                                                               Command="{Binding RemoveFromFavoritesCommand}"
                                                               CommandParameter="{Binding SelectedFavoriteSong}"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Ui.FavoritesHint}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <ListBox x:Name="FavoritesList" ItemsSource="{Binding FilteredFavoriteSongs}" ItemTemplate="{StaticResource LibrarySongTemplate}"
                                             SelectedItem="{Binding SelectedFavoriteSong}" Style="{StaticResource ListBox.Debra}"
                                             ItemContainerStyle="{StaticResource ListBoxItem.Song}"
                                             AllowDrop="True"
                                             DragOver="FavoritesList_OnDragOver"
                                             Drop="FavoritesList_OnDrop"
                                             PreviewMouseLeftButtonDown="FavoritesList_OnPreviewMouseLeftButtonDown"
                                             PreviewMouseLeftButtonUp="SongList_OnPreviewMouseLeftButtonUp"
                                             PreviewMouseMove="FavoritesList_OnPreviewMouseMove"
                                             MouseDoubleClick="Favorites_OnDoubleClick"/>
                                </DockPanel>
                            </Border>

                            <!-- NOW PLAYING (fills remaining width to align with window chrome) -->
                            <Border x:Name="TourTarget_NowPlaying" Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <controls:DebraNowPlayingArt HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    NowPlayingTitle="{Binding NowPlayingTitle}"
                                    NowPlayingSubtitle="{Binding NowPlayingSubtitle}"
                                    NowPlayingDurationDisplay="{Binding NowPlayingDurationDisplay}"
                                    NowPlayingNotesDisplay="{Binding NowPlayingNotesDisplay}"
                                    NowPlayingRange="{Binding NowPlayingRange}"/>
                            </Border>
                        </Grid>
                </Grid>

                <controls:DebraPlayerChrome x:Name="TourTarget_PlayerChrome"
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="5,7,5,6"
                                            HorizontalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Viewbox>
    <controls:TourGuideOverlay x:Name="TourGuide" Panel.ZIndex="100" Visibility="Collapsed"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Window>
