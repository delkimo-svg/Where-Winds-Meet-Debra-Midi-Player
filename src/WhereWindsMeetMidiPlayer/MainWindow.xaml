                                                        <Button Content="{Binding Ui.PracticeImport}" Style="{StaticResource Button.Gold}" Padding="10,4"
                                                                Command="{Binding ImportPracticeSongCommand}"
                                                                ToolTip="{Binding Ui.PracticeImportTooltip}"/>
                                                        <Button Content="{Binding Ui.LibraryRefresh}" Style="{StaticResource Button.Ghost}" Padding="10,4"
