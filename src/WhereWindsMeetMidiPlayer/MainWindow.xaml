                                                                   KeyboardLabelMode="{Binding PracticeNoteLabelMode}"
                                                                   PressState="{Binding PracticeKeyboardPressState}"
                                                                   HandKeyPreview="{Binding PracticeHandKeyPreview}"
                                                                   ShowHandPreview="{Binding ShowPracticeHandPreview}"
                                                                   RightHandColorHex="{Binding PracticeRightHandColorHex}"
                                                                   LeftHandColorHex="{Binding PracticeLeftHandColorHex}"
