                                        </Border>
                                        <controls:AcademyTourOverlay DataContext="{Binding}"
                                                Visibility="{Binding ShowAcademyTourOnPiano, Converter={StaticResource BoolToVis}}"/>
                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Stretch"
