<Window x:Class="WhereWindsMeetMidiPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WhereWindsMeetMidiPlayer.Converters"
        xmlns:vm="clr-namespace:WhereWindsMeetMidiPlayer.ViewModels"
        xmlns:models="clr-namespace:WhereWindsMeetMidiPlayer.Models"
        xmlns:controls="clr-namespace:WhereWindsMeetMidiPlayer.Controls"
        xmlns:behaviors="clr-namespace:WhereWindsMeetMidiPlayer.Behaviors"
        xmlns:asset="clr-namespace:WhereWindsMeetMidiPlayer.Helpers"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitleText, Mode=OneWay, FallbackValue='Debra MIDI Player'}"
        Height="682" Width="1024"
        MinHeight="640" MinWidth="940"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Topmost="{Binding WindowAlwaysOnTop, Mode=TwoWay}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        AllowDrop="True"
        Closing="Window_OnClosing"
        PreviewDragOver="Window_PreviewDragOver"
        DragOver="Window_DragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewKeyUp="Window_OnPreviewKeyUp">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="8" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <DataTemplate x:Key="LibrarySongTemplate" DataType="{x:Type models:Song}">
            <Grid VerticalAlignment="Stretch" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="♪" Foreground="{DynamicResource Brush.Gold}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Text.SongRowTitle}" Text="{Binding DisplayTitle}"
                           ToolTip="{Binding DisplayTitle}"/>
                <Button Grid.Column="2" Content="▶" Style="{StaticResource Button.Icon.Row}" VerticalAlignment="Center"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding DataContext.Ui.PlayTooltip, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                        Click="SongRowPlay_OnClick"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PracticeLibrarySongTemplate" DataType="{x:Type models:Song}">
            <Grid VerticalAlignment="Stretch" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="♪" Foreground="{DynamicResource Brush.Gold}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Text.SongRowTitle}" Text="{Binding DisplayTitle}"
                           ToolTip="{Binding DisplayTitle}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CatalogueTrackTemplate" DataType="{x:Type models:CatalogueTrack}">
            <Grid VerticalAlignment="Stretch" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource Brush.NewBadge}" CornerRadius="4"
                        Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding DataContext.Ui.CatalogueNewBadge, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                               FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.NewBadgeText}"/>
                </Border>
                <TextBlock Grid.Column="1" Style="{StaticResource Text.SongRowTitle}" Text="{Binding DisplayTitle}"
                           ToolTip="{Binding DisplayTitle}"/>
                <Button Grid.Column="2" Content="▶" Style="{StaticResource Button.Icon.Row}" VerticalAlignment="Center"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding DataContext.Ui.PlayTooltip, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                        Click="SongRowPlay_OnClick"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PlaylistSongTemplate">
            <Grid VerticalAlignment="Stretch" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexPlusOneConverter}}"/>
                <TextBlock Grid.Column="1" Text="⋮⋮" Foreground="{DynamicResource Brush.GoldDim}" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="9"/>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="♥" Foreground="{DynamicResource Brush.Gold}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"
                               Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.SongRowTitle}" Text="{Binding DisplayTitle}"
                               ToolTip="{Binding DisplayTitle}"/>
                </Grid>
                <Button Grid.Column="3" Content="▶" Style="{StaticResource Button.Icon.Row}" VerticalAlignment="Center"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding DataContext.Ui.PlayTooltip, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                        Click="SongRowPlay_OnClick"/>
                <TextBlock Grid.Column="4" Text="♫" Foreground="{DynamicResource Brush.Gold}" VerticalAlignment="Center" FontSize="14" Margin="4,0,0,0"
                           Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.IsPlaying, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Single fade layer for the whole UI: the chrome opacity slider is applied once here so
         every surface dims at the same rate instead of compounding per element. -->
    <Grid FlowDirection="{Binding UiFlowDirection}" ClipToBounds="True" Background="Transparent"
          Opacity="{Binding PlayerChromeOpacity}">
        <Image x:Name="MainBackgroundImage" Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border Background="{DynamicResource Brush.WindowBackground}"
                IsHitTestVisible="False"/>
        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Brush.BackgroundScrim}"/>

        <Grid AllowDrop="True" ClipToBounds="True" FlowDirection="{Binding UiFlowDirection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Title bar spans full width so body column 0 stays sidebar-narrow only -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ClipToBounds="False"
                      Background="Transparent">
                    <Border x:Name="TitleBarDecorHost" Panel.ZIndex="0" IsHitTestVisible="False"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                            Background="{DynamicResource Brush.BgDeep}"/>
                    <Border x:Name="TitleBarVignette" Panel.ZIndex="0" IsHitTestVisible="False"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#70141518" Offset="0"/>
                                <GradientStop Color="#30141518" Offset="0.32"/>
                                <GradientStop Color="#00141518" Offset="0.52"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="TitleBarEdgeFadeTop" Panel.ZIndex="1" Height="3" VerticalAlignment="Top"
                            HorizontalAlignment="Stretch" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{DynamicResource BgDeep}" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="TitleBarEdgeFadeBottom" Panel.ZIndex="1" Height="3" VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="{DynamicResource BgDeep}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Panel.ZIndex="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="100"/>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="12,0,8,0"
                          MouseLeftButtonDown="TitleBar_OnMouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" x:Name="HeaderLogoImage"
                               Source="{asset:LocalAsset debra-wwm-header-logo.png}"
                               Height="32" Stretch="Uniform" VerticalAlignment="Center"
                               Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{DynamicResource Font.HeaderTitle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   TextOptions.TextFormattingMode="Display">
                            <Run Text="Debra Midi Player" FontSize="17" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.GoldBright}"/>
                            <Run Text="  ·  v" FontSize="11" Foreground="{DynamicResource Brush.HeaderMetaText}"
                                 BaselineAlignment="Center"/>
                            <Run Text="{Binding AppVersionLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.HeaderMetaText}" BaselineAlignment="Center"/>
                            <Run Text="  ·  " FontSize="11" Foreground="{DynamicResource Brush.HeaderMetaMuted}"
                                 BaselineAlignment="Center"/>
                            <Run Text="{Binding SelectedGameDisplayName, Mode=OneWay}" FontSize="11" FontWeight="Normal"
                                 Foreground="{DynamicResource Brush.HeaderMetaMuted}" BaselineAlignment="Center"/>
                        </TextBlock>
                    </Grid>
                    <StackPanel x:Name="TourTarget_Header" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                Margin="0,0,6,0" Panel.ZIndex="10"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="{Binding Ui.HeaderUpdate}" Style="{StaticResource Button.UpdatePulse}"
                                Command="{Binding ShowUpdateOverlayCommand}"
                                ToolTip="{Binding Ui.HeaderUpdateTooltip}"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                FontSize="11" Margin="0,0,5,0"/>
                        <Button Content="{Binding Ui.HeaderPatreon}" Style="{StaticResource Button.Gold}" Padding="10,5"
                                Command="{Binding ShowPatreonRewardsCommand}" ToolTip="{Binding Ui.HeaderPatreonTooltip}"
                                FontSize="11" Margin="0,0,5,0"/>
                        <Button Content="{Binding Ui.HeaderDiscord}" Style="{StaticResource Button.Gold}" Padding="10,5"
                                Command="{Binding OpenDiscordCommand}" ToolTip="{Binding Ui.HeaderDiscordTooltip}"
                                FontSize="11" Margin="0,0,5,0"/>
                        <ToggleButton Style="{StaticResource Toggle.HeaderChip}"
                                      IsChecked="{Binding WindowAlwaysOnTop, Mode=TwoWay}"
                                      ToolTip="{Binding Ui.HeaderAlwaysOnTopTooltip}"
                                      Padding="8,4" Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Pin}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                </Viewbox>
                                <TextBlock Text="{Binding Ui.HeaderAlwaysOnTopLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="TourTarget_HelpButton" Content="?" Style="{StaticResource Button.WindowChrome}" Padding="8,4"
                                Command="{Binding ShowHelpCommand}" ToolTip="{Binding Ui.HelpTooltip}"
                                FontWeight="SemiBold" FontSize="14" Margin="0,0,5,0"/>
                        <Border Background="{DynamicResource Brush.HeaderChipBackground}" CornerRadius="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="6,2" Margin="0,0,0,0" ClipToBounds="False"
                                ToolTip="{Binding SelectedGameDisplayName}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True" Margin="0,0,6,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <Image Source="{asset:LocalAsset debra-thumb-art.png}" Stretch="UniformToFill"/>
                                </Border>
                                <controls:DebraFastDropdown Width="88" MinHeight="24" VerticalAlignment="Center"
                                                            ItemsSource="{Binding GameOptions}"
                                                            SelectedItem="{Binding SelectedGameProfile, Mode=TwoWay}"
                                                            DisplayMemberPath="ShortName"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="TitleBarWindowButtons" Background="{DynamicResource Brush.BgElevated}" CornerRadius="10"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="2,0"
                            Margin="0,0,6,0" VerticalAlignment="Center"
                            Panel.ZIndex="10" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="—" Style="{StaticResource Button.WindowChrome}" Click="Minimize_OnClick"/>
                            <Button Content="□" Style="{StaticResource Button.WindowChrome}" Click="Maximize_OnClick"/>
                            <Button Content="✕" Style="{StaticResource Button.WindowChrome}" Click="Close_OnClick"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Grid>

                <controls:DebraSidebar x:Name="TourTarget_Sidebar"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="5,6,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch"
                                       NavItems="{Binding NavItems}"/>

                <Grid x:Name="MainContentStack" Grid.Row="1" Grid.Column="1" Margin="0,6,5,0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <controls:ChromeFadeCard x:Name="TourTarget_Settings" SurfaceBackground="{DynamicResource Brush.SettingsShellBackground}" CornerRadius="16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="10"
                                Visibility="{Binding ShowSettingsPanel, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" ClipToBounds="True">
                                <StackPanel MaxWidth="480">
                                    <TextBlock Text="{Binding Ui.SectionSettings}" Style="{StaticResource Text.SectionHeader}" Margin="0,0,0,16"/>
                                    <TextBlock Text="{Binding Ui.SettingsTheme}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableThemes}" DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                              Style="{StaticResource ComboBox.Debra}" Margin="0,0,0,16"/>
                                    <TextBlock Text="{Binding Ui.SettingsTargetExecutable}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding TargetProcessName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Search}"/>
                                        <Button Grid.Column="1" Content="{Binding Ui.SettingsReset}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding ResetProcessNameCommand}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Ui.SettingsWindowTitle}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding GameWindowTitleContains, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Search}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{Binding Ui.SettingsTestKey}" Style="{StaticResource Button.Gold}" Command="{Binding TestKeyInGameCommand}" Margin="0,0,6,0"/>
                                        <Button Content="{Binding Ui.SettingsDetect}" Style="{StaticResource Button.Ghost}" Command="{Binding DetectGameWindowsCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Ui.SettingsPlayback}" Style="{StaticResource Text.Title}" Margin="0,20,0,8"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsLiveMidi}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Toggle.Debra}" IsChecked="{Binding IsLiveMidiEnabled}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Ui.SettingsLiveMidiHint}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Ui.SettingsLiveMidiDevice}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding MidiInputDevices}" DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedMidiInputDevice, Mode=TwoWay}"
                                                  Style="{StaticResource ComboBox.Debra}"/>
                                        <Button Grid.Column="1" Content="{Binding Ui.SettingsLiveMidiRefresh}" Style="{StaticResource Button.Ghost}"
                                                Margin="6,0,0,0" Command="{Binding RefreshMidiInputDevicesCommand}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding LiveMidiStatusText}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Ui.SettingsPlayerHotkeys}" Style="{StaticResource Text.Title}" Margin="0,16,0,4"/>
                                    <TextBlock Text="{Binding Ui.SettingsPlayerHotkeysHint}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsHotkeyPlayPause}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding PlaybackHotkeyPlayPauseLabel}" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding BeginCapturePlaybackHotkeyCommand}" CommandParameter="{x:Static models:PlaybackHotkeyRole.PlayPause}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsHotkeyStop}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding PlaybackHotkeyStopLabel}" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding BeginCapturePlaybackHotkeyCommand}" CommandParameter="{x:Static models:PlaybackHotkeyRole.Stop}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsHotkeyPrevious}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding PlaybackHotkeyPreviousLabel}" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding BeginCapturePlaybackHotkeyCommand}" CommandParameter="{x:Static models:PlaybackHotkeyRole.Previous}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsHotkeyNext}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding PlaybackHotkeyNextLabel}" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding BeginCapturePlaybackHotkeyCommand}" CommandParameter="{x:Static models:PlaybackHotkeyRole.Next}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding PlaybackHotkeyCaptureStatus}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,0,0,6"/>
                                    <Button Content="{Binding Ui.SettingsHotkeyReset}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                            Command="{Binding ResetPlaybackHotkeysCommand}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsSmartTranspose}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Toggle.Debra}" IsChecked="{Binding SmartTranspose}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Ui.SettingsAdvancedSettings}" Style="{StaticResource Text.Title}" Margin="0,16,0,8"/>
                                    <TextBlock Text="{Binding Ui.SettingsNoteMappingMode}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding NoteMappingModes}" DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedNoteMappingMode, Mode=TwoWay}"
                                              Style="{StaticResource ComboBox.Debra}"/>
                                    <TextBlock Text="{Binding SelectedNoteMappingModeDescription}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsNoteDelay}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding NoteDelayMs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Search}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Ui.SettingsNoteDelayHint}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsChordRoll}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding ChordRollDelayMs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Search}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Ui.SettingsChordRollHint}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ui.SettingsModifierDelay}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding ModifierDelayMs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Search}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Ui.SettingsModifierDelayHint}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Ui.SettingsAutoPlayNext}" Style="{StaticResource Text.Muted}" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding AutoPlayNextDelaySeconds, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Search}"/>
                                    <TextBlock Text="{Binding Ui.SettingsAutoPlayNextHint}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Ui.SettingsLibraryRefreshFolder}" Style="{StaticResource Text.Title}" Margin="0,16,0,4"/>
                                    <TextBlock Text="{Binding Ui.SettingsLibraryRefreshFolderHint}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding LibraryRefreshFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextBox.Search}" IsReadOnly="True"
                                                 ToolTip="{Binding LibraryRefreshFolderPath}"/>
                                        <Button Grid.Column="1" Content="{Binding Ui.SettingsChooseFolder}" Style="{StaticResource Button.Ghost}"
                                                Margin="8,0,0,0" Command="{Binding ChooseLibraryRefreshFolderCommand}"/>
                                    </Grid>
                                    <CheckBox Content="{Binding Ui.LibraryIncludeSubfolders}" IsChecked="{Binding LibraryIncludeSubfolders, Mode=TwoWay}"
                                              Margin="0,0,0,8" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding Ui.SettingsPracticeLibraryRefreshFolder}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Ui.SettingsPracticeLibraryRefreshFolderHint}" Style="{StaticResource Text.Muted}" FontSize="9" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding PracticeLibraryRefreshFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextBox.Search}" IsReadOnly="True"
                                                 ToolTip="{Binding PracticeLibraryRefreshFolderPath}"/>
                                        <Button Grid.Column="1" Content="{Binding Ui.SettingsChooseFolder}" Style="{StaticResource Button.Ghost}"
                                                Margin="8,0,0,0" Command="{Binding ChoosePracticeLibraryRefreshFolderCommand}"/>
                                    </Grid>
