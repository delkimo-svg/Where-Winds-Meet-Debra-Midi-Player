                                                        <DataTrigger Binding="{Binding ShowAcademyTourOnPiano}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PracticeTitle}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"
