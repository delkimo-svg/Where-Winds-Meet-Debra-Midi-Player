                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Margin="0,8,0,0" Padding="0,8,0,0"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
