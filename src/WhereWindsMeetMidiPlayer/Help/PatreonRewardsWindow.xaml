<Window x:Class="WhereWindsMeetMidiPlayer.Help.PatreonRewardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patreon Rewards"
        Width="480" SizeToContent="Height"
        MinWidth="400" MaxWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="#FFF5F8" BorderBrush="#E8B4C4" BorderThickness="1" CornerRadius="14" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="#558E3D55" BlurRadius="20" ShadowDepth="3" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F8E8EE" BorderBrush="#E8B4C4" BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0" Padding="18,14">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,36,0">
                        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="#8E3D55"
                                   FontFamily="Georgia, SimSun, Times New Roman" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#8A6068" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource Button.WindowChrome}" Click="Close_OnClick" Padding="8,4"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,16,18,8">
                <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="#4A3038" FontSize="13" LineHeight="20"
                           Margin="0,0,0,14"/>
                <TextBlock x:Name="HowTitleText" FontWeight="SemiBold" Foreground="#8E3D55" FontSize="13" Margin="0,0,0,10"/>
                <StackPanel x:Name="StepsPanel" Margin="0,0,0,14"/>
                <TextBlock x:Name="PriceText" TextWrapping="Wrap" Foreground="#6E2D42" FontSize="12.5" LineHeight="19"
                           FontStyle="Italic"/>
            </StackPanel>

            <Border Grid.Row="2" Padding="18,8,18,16" BorderBrush="#E8B4C4" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton" Style="{StaticResource Button.Ghost}" MinWidth="88" Margin="0,0,8,0"
                            Click="Close_OnClick"/>
                    <Button x:Name="JoinButton" Style="{StaticResource Button.Gold}" MinWidth="120"
                            Click="Join_OnClick" IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
