<Window x:Class="WhereWindsMeetMidiPlayer.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debra MIDI Player - Help"
        Width="600" Height="680"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource Brush.TourCalloutBackground}"
            BorderBrush="{DynamicResource Brush.TourCalloutBorder}"
            BorderThickness="1" CornerRadius="14" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource PanelShadow}" BlurRadius="20" ShadowDepth="3" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.BgHover}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0" Padding="18,14">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TourTitle}"
                                   FontFamily="{DynamicResource Font.HeaderTitle}"/>
                        <TextBlock x:Name="HeaderSubtitleText" FontSize="11"
                                   Foreground="{DynamicResource Brush.TourStep}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource Button.WindowChrome}" Click="Close_OnClick" Padding="8,4"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14,18,10"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SectionsPanel" MaxWidth="540"/>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="18,10,18,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <Button x:Name="CloseFooterButton" Style="{StaticResource Button.Gold}" HorizontalAlignment="Right"
                        MinWidth="100" Click="Close_OnClick" IsDefault="True"/>
            </Border>
        </Grid>
    </Border>
</Window>
