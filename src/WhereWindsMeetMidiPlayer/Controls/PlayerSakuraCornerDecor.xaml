<UserControl x:Class="WhereWindsMeetMidiPlayer.Controls.PlayerSakuraCornerDecor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asset="clr-namespace:WhereWindsMeetMidiPlayer.Helpers"
             IsHitTestVisible="False"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             RenderTransformOrigin="1,1"
             Width="132" Height="96">

    <UserControl.Resources>
        <RadialGradientBrush x:Key="PetalBrush" GradientOrigin="0.35,0.35">
            <GradientStop Color="#FFF8D4E0" Offset="0"/>
            <GradientStop Color="#FFE89AB0" Offset="0.55"/>
            <GradientStop Color="#FFD4899E" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="PetalBrushSoft" GradientOrigin="0.4,0.4">
            <GradientStop Color="#CCFFE8F0" Offset="0"/>
            <GradientStop Color="#99F5B8C8" Offset="1"/>
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- Raster branch (transparent PNG) -->
        <Image x:Name="CornerRaster"
               Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Width="128" Height="96" Opacity="0.92"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Vector petals (Sakura theme only) -->
        <Canvas x:Name="VectorPetals" Width="132" Height="96" ClipToBounds="False">
            <Path Stroke="#9A6B5C" StrokeThickness="1.6" Opacity="0.55"
                  Data="M 128,94 C 102,90 92,72 98,52 C 104,34 114,16 126,4"/>
            <Path Stroke="#B88A7A" StrokeThickness="1" Opacity="0.4"
                  Data="M 118,88 C 108,82 104,68 110,54"/>

            <Ellipse Canvas.Left="108" Canvas.Top="62" Width="14" Height="9" Fill="{StaticResource PetalBrush}" Opacity="0.95"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="-24"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="96" Canvas.Top="70" Width="12" Height="8" Fill="{StaticResource PetalBrushSoft}" Opacity="0.9"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="18"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="114" Canvas.Top="48" Width="11" Height="7" Fill="{StaticResource PetalBrush}" Opacity="0.88"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="42"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="120" Canvas.Top="34" Width="10" Height="6" Fill="{StaticResource PetalBrushSoft}" Opacity="0.85"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="-8"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="102" Canvas.Top="52" Width="9" Height="6" Fill="#FFFCE4EC" Opacity="0.75"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="-35"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="88" Canvas.Top="78" Width="8" Height="5" Fill="{StaticResource PetalBrushSoft}" Opacity="0.7"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="55"/></Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse Canvas.Left="124" Canvas.Top="22" Width="5" Height="5" Fill="#FFE8B4C4" Opacity="0.8"/>
            <Ellipse Canvas.Left="76" Canvas.Top="86" Width="4" Height="4" Fill="#FFF5C6D6" Opacity="0.65"/>
        </Canvas>
    </Grid>
</UserControl>
