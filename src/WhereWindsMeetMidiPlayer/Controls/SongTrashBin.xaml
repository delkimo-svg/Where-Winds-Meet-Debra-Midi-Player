<UserControl x:Class="WhereWindsMeetMidiPlayer.Controls.SongTrashBin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="34" Height="34">
    <Border x:Name="DropBorder" CornerRadius="8" BorderThickness="1"
            BorderBrush="#E8B4C4" Background="Transparent" Cursor="Hand"
            AllowDrop="True"
            ToolTip="{Binding DataContext.Ui.TrashTooltip, RelativeSource={RelativeSource AncestorType=Window}}"
            PreviewMouseLeftButtonDown="DropBorder_OnPreviewMouseLeftButtonDown"
            DragEnter="DropBorder_OnDragEnter"
            DragOver="DropBorder_OnDragOver"
            DragLeave="DropBorder_OnDragLeave"
            Drop="DropBorder_OnDrop">
        <Path x:Name="TrashIcon" Width="16" Height="16" Stretch="Uniform"
              Fill="#8E3D55" HorizontalAlignment="Center" VerticalAlignment="Center"
              Data="{StaticResource Icon.Trash}"/>
    </Border>
</UserControl>
