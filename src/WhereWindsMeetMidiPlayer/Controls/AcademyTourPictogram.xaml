<UserControl x:Class="WhereWindsMeetMidiPlayer.Controls.AcademyTourPictogram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="52" HorizontalAlignment="Center">
    <Viewbox Stretch="Uniform" MaxHeight="52" MaxWidth="200">
        <Canvas Width="200" Height="52">
            <!-- Middle C landmark: two black keys + highlighted C -->
            <Canvas x:Name="MiddleCGroup" Visibility="Collapsed">
                <Rectangle Canvas.Left="58" Canvas.Top="8" Width="10" Height="22" RadiusX="2" RadiusY="2" Fill="#333"/>
                <Rectangle Canvas.Left="78" Canvas.Top="8" Width="10" Height="22" RadiusX="2" RadiusY="2" Fill="#333"/>
                <Rectangle Canvas.Left="48" Canvas.Top="14" Width="16" Height="34" RadiusX="3" RadiusY="3" Fill="#F5F5F5" Stroke="#CCC" StrokeThickness="1"/>
                <Rectangle Canvas.Left="64" Canvas.Top="14" Width="16" Height="34" RadiusX="3" RadiusY="3" Fill="{DynamicResource Brush.Gold}" Stroke="{DynamicResource Brush.GoldBright}" StrokeThickness="2"/>
                <Rectangle Canvas.Left="80" Canvas.Top="14" Width="16" Height="34" RadiusX="3" RadiusY="3" Fill="#F5F5F5" Stroke="#CCC" StrokeThickness="1"/>
                <Rectangle Canvas.Left="96" Canvas.Top="14" Width="16" Height="34" RadiusX="3" RadiusY="3" Fill="#F5F5F5" Stroke="#CCC" StrokeThickness="1"/>
                <TextBlock Canvas.Left="64" Canvas.Top="48" Width="16" Text="C" FontSize="9" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource Brush.GoldBright}"/>
            </Canvas>

            <!-- Ascending steps -->
            <Canvas x:Name="StepsUpGroup" Visibility="Collapsed">
                <Rectangle Canvas.Left="20" Canvas.Top="30" Width="14" Height="18" RadiusX="2" Fill="#E8E8E8" Stroke="#CCC"/>
                <Rectangle Canvas.Left="38" Canvas.Top="24" Width="14" Height="24" RadiusX="2" Fill="#E8E8E8" Stroke="#CCC"/>
                <Rectangle Canvas.Left="56" Canvas.Top="18" Width="14" Height="30" RadiusX="2" Fill="#E8E8E8" Stroke="#CCC"/>
                <Rectangle Canvas.Left="74" Canvas.Top="12" Width="14" Height="36" RadiusX="2" Fill="#E8E8E8" Stroke="#CCC"/>
                <Rectangle Canvas.Left="92" Canvas.Top="6" Width="14" Height="42" RadiusX="2" Fill="#4A9EFF" Stroke="#2B7FE0" StrokeThickness="1.5"/>
                <Path Canvas.Left="108" Canvas.Top="4" Data="M0,20 L12,8 L12,32 Z" Fill="{DynamicResource Brush.GoldBright}"/>
            </Canvas>

            <!-- Descending steps -->
            <Canvas x:Name="StepsDownGroup" Visibility="Collapsed">
                <Rectangle Canvas.Left="20" Canvas.Top="6" Width="14" Height="42" RadiusX="2" Fill="#4A9EFF" Stroke="#2B7FE0" StrokeThickness="1.5"/>
                <Rectangle Canvas.Left="38" Canvas.Top="12" Width="14" Height="36" RadiusX="2" Fill="#E8E8E8" Stroke="#CCC"/>
                <Rectangle Canvas.Left="56" Canvas.Top="18" Width="14" Height="30" RadiusX="2" Fill="#E8E8E8" Stroke="#CCC"/>
                <Rectangle Canvas.Left="74" Canvas.Top="24" Width="14" Height="24" RadiusX="2" Fill="#E8E8E8" Stroke="#CCC"/>
                <Rectangle Canvas.Left="92" Canvas.Top="30" Width="14" Height="18" RadiusX="2" Fill="#E8E8E8" Stroke="#CCC"/>
                <Path Canvas.Left="108" Canvas.Top="20" Data="M0,8 L12,20 L12,36 Z" Fill="{DynamicResource Brush.GoldBright}"/>
            </Canvas>

            <!-- Count 1-2-3-4 -->
            <Canvas x:Name="CountGroup" Visibility="Collapsed">
                <Ellipse Canvas.Left="8" Canvas.Top="10" Width="32" Height="32" Fill="#FFF5F8" Stroke="{DynamicResource Brush.Gold}" StrokeThickness="1.5"/>
                <TextBlock Canvas.Left="8" Canvas.Top="16" Width="32" Text="1" FontSize="14" FontWeight="Bold" TextAlignment="Center" Foreground="{DynamicResource Brush.GoldBright}"/>
                <Ellipse Canvas.Left="44" Canvas.Top="10" Width="32" Height="32" Fill="#FFF5F8" Stroke="{DynamicResource Brush.Gold}" StrokeThickness="1.5"/>
                <TextBlock Canvas.Left="44" Canvas.Top="16" Width="32" Text="2" FontSize="14" FontWeight="Bold" TextAlignment="Center" Foreground="{DynamicResource Brush.GoldBright}"/>
                <Ellipse Canvas.Left="80" Canvas.Top="10" Width="32" Height="32" Fill="#FFF5F8" Stroke="{DynamicResource Brush.Gold}" StrokeThickness="1.5"/>
                <TextBlock Canvas.Left="80" Canvas.Top="16" Width="32" Text="3" FontSize="14" FontWeight="Bold" TextAlignment="Center" Foreground="{DynamicResource Brush.GoldBright}"/>
                <Ellipse Canvas.Left="116" Canvas.Top="10" Width="32" Height="32" Fill="#FFF5F8" Stroke="{DynamicResource Brush.Gold}" StrokeThickness="1.5"/>
                <TextBlock Canvas.Left="116" Canvas.Top="16" Width="32" Text="4" FontSize="14" FontWeight="Bold" TextAlignment="Center" Foreground="{DynamicResource Brush.GoldBright}"/>
            </Canvas>

            <!-- Listen / speaker -->
            <Canvas x:Name="ListenGroup" Visibility="Collapsed">
                <Ellipse Canvas.Left="30" Canvas.Top="8" Width="36" Height="36" Fill="#FFF5F8" Stroke="{DynamicResource Brush.Gold}" StrokeThickness="1.5"/>
                <Path Canvas.Left="42" Canvas.Top="18" Data="M0,8 L8,8 L14,4 L14,28 L8,24 L0,24 Z" Fill="{DynamicResource Brush.GoldBright}"/>
                <Path Canvas.Left="58" Canvas.Top="16" Data="M0,8 Q8,0 16,8 Q8,16 0,8 M16,4 Q24,12 16,20" Stroke="{DynamicResource Brush.GoldBright}" StrokeThickness="2" Fill="Transparent"/>
                <TextBlock Canvas.Left="88" Canvas.Top="16" Text="▶ Listen" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.GoldBright}"/>
            </Canvas>

            <!-- Mirror hands -->
            <Canvas x:Name="MirrorGroup" Visibility="Collapsed">
                <Rectangle Canvas.Left="24" Canvas.Top="20" Width="12" Height="28" RadiusX="4" Fill="#F59E0B" Opacity="0.85"/>
                <Rectangle Canvas.Left="38" Canvas.Top="14" Width="12" Height="34" RadiusX="4" Fill="#F59E0B" Opacity="0.7"/>
                <Rectangle Canvas.Left="52" Canvas.Top="10" Width="12" Height="38" RadiusX="4" Fill="#F59E0B"/>
                <Rectangle Canvas.Left="66" Canvas.Top="14" Width="12" Height="34" RadiusX="4" Fill="#F59E0B" Opacity="0.7"/>
                <Rectangle Canvas.Left="80" Canvas.Top="20" Width="12" Height="28" RadiusX="4" Fill="#F59E0B" Opacity="0.85"/>
                <Rectangle Canvas.Left="108" Canvas.Top="20" Width="12" Height="28" RadiusX="4" Fill="#4A9EFF" Opacity="0.85"/>
                <Rectangle Canvas.Left="122" Canvas.Top="14" Width="12" Height="34" RadiusX="4" Fill="#4A9EFF" Opacity="0.7"/>
                <Rectangle Canvas.Left="136" Canvas.Top="10" Width="12" Height="38" RadiusX="4" Fill="#4A9EFF"/>
                <Rectangle Canvas.Left="150" Canvas.Top="14" Width="12" Height="34" RadiusX="4" Fill="#4A9EFF" Opacity="0.7"/>
                <Rectangle Canvas.Left="164" Canvas.Top="20" Width="12" Height="28" RadiusX="4" Fill="#4A9EFF" Opacity="0.85"/>
            </Canvas>

            <!-- Go / play -->
            <Canvas x:Name="GoGroup" Visibility="Collapsed">
                <Ellipse Canvas.Left="50" Canvas.Top="4" Width="44" Height="44" Fill="{DynamicResource Brush.Gold}" Opacity="0.25"/>
                <Path Canvas.Left="66" Canvas.Top="16" Data="M0,0 L24,12 L0,24 Z" Fill="{DynamicResource Brush.GoldBright}"/>
                <TextBlock Canvas.Left="20" Canvas.Top="46" Width="160" Text="Press ▶ to start" FontSize="10" TextAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
