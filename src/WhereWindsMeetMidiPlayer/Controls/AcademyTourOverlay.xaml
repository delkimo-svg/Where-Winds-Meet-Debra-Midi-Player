<UserControl x:Class="WhereWindsMeetMidiPlayer.Controls.AcademyTourOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WhereWindsMeetMidiPlayer.ViewModels"
             xmlns:controls="clr-namespace:WhereWindsMeetMidiPlayer.Controls"
             VerticalAlignment="Top" HorizontalAlignment="Left"
             Margin="12,12,0,0" IsHitTestVisible="True">
    <Border Background="#E8FFF5F8" BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1"
            CornerRadius="12" Padding="14,12" MaxWidth="380">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding AcademyTourStepLabel}"
                       Style="{StaticResource Text.Muted}" FontSize="10" Margin="0,0,0,6"/>
            <controls:AcademyTourPictogram Grid.Row="1" Hint="{Binding AcademyTourPictogramHint}"
                                           Visibility="{Binding AcademyTourShowPictogram, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,0,8"/>
            <controls:AcademyHandDiagram Grid.Row="2"
                                         HighlightHand="{Binding AcademyTourHighlightHand}"
                                         Visibility="{Binding AcademyTourShowHandDiagram, Converter={StaticResource BoolToVis}}"
                                         Margin="0,0,0,8"/>
            <TextBlock Grid.Row="3" Text="{Binding AcademyTourText}" TextWrapping="Wrap"
                       FontSize="12" LineHeight="17" Margin="0,0,0,10"
                       Visibility="{Binding AcademyTourShowTourContent, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Grid.Row="4" Margin="0,0,0,10"
                        Visibility="{Binding IsAcademyTourSongPickerVisible, Converter={StaticResource BoolToVis}}">
                <ComboBox Margin="0,0,0,8"
                          ItemsSource="{Binding AcademyPanel.SongLessons}"
                          SelectedItem="{Binding AcademyPanel.SelectedSongLesson, Mode=TwoWay}"
                          Style="{StaticResource ComboBox.Debra}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AcademyLessonRowViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Lesson.Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="✓" Foreground="{DynamicResource Brush.Gold}" Margin="6,0,0,0"
                                           Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Background="#F5EDE8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="8" Padding="8,6">
                    <TextBlock Text="{Binding AcademyTourSwitchSongHint}" TextWrapping="Wrap"
                               FontSize="11" LineHeight="15" Foreground="{DynamicResource Brush.TextMuted}"/>
                </Border>
            </StackPanel>
            <Grid Grid.Row="5">
                <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                        Content="{Binding AcademyTourPlayLabel}" Style="{StaticResource Button.Gold}"
                        Command="{Binding AcademyTourPlayCurrentLessonCommand}"
                        Visibility="{Binding AcademyTourShowPlayButton, Converter={StaticResource BoolToVis}}"
                        Padding="10,6"/>
                <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                        Content="{Binding AcademyTourPlayLabel}" Style="{StaticResource Button.Gold}"
                        Command="{Binding AcademyTourPlaySelectedSongCommand}"
                        Visibility="{Binding AcademyTourShowSongPickerPlayButton, Converter={StaticResource BoolToVis}}"
                        Padding="10,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding AcademyTourBackLabel}" Style="{StaticResource Button.Ghost}"
                            Command="{Binding AcademyTourBackCommand}" Margin="0,0,6,0"/>
                    <Button Content="{Binding AcademyTourNextLabel}" Style="{StaticResource Button.Ghost}"
                            Command="{Binding AcademyTourNextCommand}" Margin="0,0,6,0"
                            Visibility="{Binding AcademyTourShowDismissButton, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{Binding AcademyTourSkipNextLabel}" Style="{StaticResource Button.Gold}"
                            Command="{Binding AcademyTourSkipNextCommand}"
                            Visibility="{Binding AcademyTourShowDismissButton, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{Binding AcademyTourNextLabel}" Style="{StaticResource Button.Gold}"
                            Command="{Binding AcademyTourNextCommand}"
                            Visibility="{Binding AcademyTourShowPrimaryNextButton, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
