<UserControl x:Class="WhereWindsMeetMidiPlayer.Controls.DebraFastDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="28"
             Focusable="False">
    <Grid>
        <Border x:Name="Chrome"
                Background="{DynamicResource Brush.InputBackground}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"/>
        <ToggleButton x:Name="OpenToggle"
                      Focusable="False"
                      ClickMode="Press"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      IsChecked="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <TextBlock x:Name="SelectionText"
                   Margin="10,6,28,6"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.ComboBoxForeground}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   IsHitTestVisible="False"/>
        <Path Data="M 0 0 L 4 4 L 8 0 Z"
              Fill="{DynamicResource Brush.ComboBoxForeground}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Margin="0,0,10,0"
              Width="8"
              Height="5"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Popup x:Name="DropDownPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=Root}"
               AllowsTransparency="False"
               PopupAnimation="None"
               StaysOpen="False"
               IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}">
            <Border MinWidth="{Binding ActualWidth, ElementName=Root}"
                    MaxHeight="{Binding MaxDropDownHeight, ElementName=Root}"
                    Background="{DynamicResource Brush.ComboBoxPopupBackground}"
                    BorderBrush="{DynamicResource Brush.ComboBoxPopupBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,2,0,0"
                    SnapsToDevicePixels="True">
                <ListBox x:Name="ItemsList"
                         ItemsSource="{Binding ItemsSource, ElementName=Root}"
                         SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=OneWay}"
                         DisplayMemberPath="{Binding DisplayMemberPath, ElementName=Root}"
                         Foreground="{DynamicResource Brush.ComboBoxPopupForeground}"
                         Focusable="True"
                         BorderThickness="0"
                         Background="Transparent"
                         MaxHeight="{Binding MaxDropDownHeight, ElementName=Root}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingPanel.IsVirtualizing="False"
                         PreviewMouseWheel="ItemsList_OnPreviewMouseWheel"
                         SelectionChanged="ItemsList_OnSelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.DropdownPopup}"/>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
