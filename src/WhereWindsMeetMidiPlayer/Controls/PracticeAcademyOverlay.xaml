<UserControl x:Class="WhereWindsMeetMidiPlayer.Controls.PracticeAcademyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WhereWindsMeetMidiPlayer.ViewModels"
             xmlns:controls="clr-namespace:WhereWindsMeetMidiPlayer.Controls"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Right"
             MinWidth="300"
             MaxWidth="340">
    <Border Background="{DynamicResource Brush.CardBackground}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0"
            CornerRadius="16,0,0,16" Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DataContext.Ui.SectionAcademy, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource Text.SectionHeader}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Style="{StaticResource Button.Icon.Row}" Content="✕"
                                Command="{Binding DataContext.ClosePracticeAcademyOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Panel.ZIndex="2"
                                HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>

                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" FontSize="9"
                               Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <Button Content="{Binding DataContext.Ui.AcademyRefresh, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource Button.Ghost}" Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding DataContext.Ui.AcademyPickClass, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                              Style="{StaticResource ComboBox.Debra}" Margin="0,0,0,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AcademyModuleRowViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Badge}" FontWeight="Bold" Foreground="{DynamicResource Brush.Gold}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="✓" Foreground="{DynamicResource Brush.Gold}" Margin="4,0,0,0"
                                               Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Background="#22000000" CornerRadius="8" Padding="8" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <TextBlock Text="{Binding ModuleGuideText}" TextWrapping="Wrap"
                                   Style="{StaticResource Text.Muted}" FontSize="11" LineHeight="15"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="10" Height="10" CornerRadius="5" Background="#4ADE80" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DataContext.Ui.AcademyHandRightShort, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,14,0"/>
                        <Border Width="10" Height="10" CornerRadius="5" Background="#4A9EFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DataContext.Ui.AcademyHandLeftShort, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>

                    <Border Background="#18FFF5F8" CornerRadius="10" Padding="10,8" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1"
                            Visibility="{Binding HasActiveLesson, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.Ui.AcademyYourLesson, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.GoldBright}" Margin="0,0,0,6"/>
                            <controls:AcademyHandDiagram HighlightHand="{Binding ActiveLessonHand}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ActiveLessonGuide}" TextWrapping="Wrap"
                                       FontSize="11" LineHeight="15" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding DataContext.Ui.AcademyExercises, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource Text.Muted}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,6,0"
                                  ItemsSource="{Binding ExerciseLessons}" SelectedItem="{Binding SelectedExerciseLesson, Mode=TwoWay}"
                                  Style="{StaticResource ComboBox.Debra}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AcademyLessonRowViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Lesson.Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="✓" Foreground="{DynamicResource Brush.Gold}" Margin="6,0,0,0"
                                                   Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="▶" Style="{StaticResource Button.Icon.Row}"
                                Command="{Binding PlayExerciseCommand}"
                                ToolTip="{Binding DataContext.Ui.PlayTooltip, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                    </Grid>

                    <TextBlock Text="{Binding DataContext.Ui.AcademyPracticeSongs, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource Text.Muted}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,6,0"
                                  ItemsSource="{Binding SongLessons}" SelectedItem="{Binding SelectedSongLesson, Mode=TwoWay}"
                                  Style="{StaticResource ComboBox.Debra}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AcademyLessonRowViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Lesson.Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="✓" Foreground="{DynamicResource Brush.Gold}" Margin="6,0,0,0"
                                                   Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="▶" Style="{StaticResource Button.Icon.Row}"
                                Command="{Binding PlaySongCommand}"
                                ToolTip="{Binding DataContext.Ui.PlayTooltip, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="1" Margin="0,10,0,0" Height="44" MaxHeight="44"
                    Content="{Binding DataContext.Ui.AcademyReady, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource Button.Gold}" HorizontalAlignment="Stretch"
                    Command="{Binding ReadyCommand}" VerticalAlignment="Bottom"/>
        </Grid>
    </Border>
</UserControl>
